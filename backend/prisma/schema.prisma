generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Los campos de tipo/estado se modelan como String (no enum nativo de Prisma) y se
// validan en la capa de la API (Zod) contra las listas de valores permitidos
// documentadas en cada campo — arrancó así cuando la base era SQLite (que no soporta
// enums) y se mantiene igual al pasar a PostgreSQL por simplicidad y consistencia.

model Cuenta {
  id          Int      @id @default(autoincrement())
  nombre      String
  tipo        String // EFECTIVO | BANCO | TARJETA_CREDITO
  saldoActual Float    @default(0)
  moneda      String   @default("USD")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transacciones            Transaccion[]
  ordenesPermanentes       OrdenPermanente[]
  transaccionesProgramadas TransaccionProgramada[]

  @@map("cuentas")
}

// Soporta un nivel de subcategoría (ej. "Alimentación" -> "Supermercado") vía
// categoriaPadreId auto-referenciado. Una categoría raíz tiene categoriaPadreId = null.
model CategoriaGasto {
  id               Int             @id @default(autoincrement())
  nombre           String
  tipo             String // GASTO | INGRESO
  color            String?
  icono            String?
  categoriaPadreId Int?
  categoriaPadre   CategoriaGasto? @relation("Subcategorias", fields: [categoriaPadreId], references: [id], onDelete: Cascade)
  subcategorias    CategoriaGasto[] @relation("Subcategorias")

  transacciones            Transaccion[]
  ordenesPermanentes       OrdenPermanente[]
  transaccionesProgramadas TransaccionProgramada[]

  @@index([categoriaPadreId])
  @@map("categorias_gasto")
}

// El par (mes, anio) es el mes contable al que pertenece la transacción para los
// reportes mensuales; no necesariamente coincide con el mes calendario de "fecha" si
// el usuario decide imputar un movimiento a otro periodo.
model Transaccion {
  id          Int      @id @default(autoincrement())
  nombre      String // nombre del gasto/ingreso, para identificarlo en los listados
  tipo        String // GASTO | INGRESO
  categoriaId Int
  categoria   CategoriaGasto @relation(fields: [categoriaId], references: [id])
  cuentaId    Int
  cuenta      Cuenta   @relation(fields: [cuentaId], references: [id])
  valor       Float
  fecha       DateTime
  descripcion String?
  mes         Int
  anio        Int
  estado      String   @default("PENDIENTE") // PENDIENTE | CONFIRMADA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Trazabilidad de origen: si esta transacción fue generada automáticamente por una
  // orden permanente (replicación mensual/quincenal/anual) o al ejecutar una
  // transacción programada, en vez de haberse creado manualmente. Sirve además para
  // no duplicar la generación de un mismo periodo.
  ordenPermanenteId       Int?
  ordenPermanente         OrdenPermanente?        @relation(fields: [ordenPermanenteId], references: [id])
  transaccionProgramadaId Int?                     @unique
  transaccionProgramada   TransaccionProgramada?   @relation(fields: [transaccionProgramadaId], references: [id])

  @@index([mes, anio])
  @@index([cuentaId])
  @@index([categoriaId])
  @@index([ordenPermanenteId])
  @@map("transacciones")
}

// Representa pagos/cobros fijos recurrentes (arriendo, suscripciones, nómina, etc.)
// que se replican automáticamente cada periodo mientras estén activos.
model OrdenPermanente {
  id           Int      @id @default(autoincrement())
  nombre       String
  categoriaId  Int
  categoria    CategoriaGasto @relation(fields: [categoriaId], references: [id])
  cuentaId     Int
  cuenta       Cuenta   @relation(fields: [cuentaId], references: [id])
  valor        Float
  diaCobroPago Int
  frecuencia   String   @default("MENSUAL") // MENSUAL | QUINCENAL | ANUAL
  activa       Boolean  @default(true)
  fechaInicio  DateTime
  fechaFin     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transaccionesGeneradas Transaccion[]

  @@index([cuentaId])
  @@index([categoriaId])
  @@map("ordenes_permanentes")
}

// Movimientos puntuales a futuro que aún no han ocurrido (a diferencia de
// OrdenPermanente, que es recurrente).
model TransaccionProgramada {
  id              Int      @id @default(autoincrement())
  nombre          String
  categoriaId     Int
  categoria       CategoriaGasto @relation(fields: [categoriaId], references: [id])
  cuentaId        Int
  cuenta          Cuenta   @relation(fields: [cuentaId], references: [id])
  valor           Float
  fechaProgramada DateTime
  estado          String   @default("PENDIENTE") // PENDIENTE | EJECUTADA | CANCELADA
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transaccionGenerada Transaccion?

  @@index([cuentaId])
  @@index([categoriaId])
  @@map("transacciones_programadas")
}
